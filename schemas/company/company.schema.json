{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "company.schema.json",
  "title": "Company",
  "$comment": "Sprint 1B: campos obrigatórios; 'consultants' pode ser vazio. Corresponde a src/domain/company/company.py.",
  "type": "object",
  "properties": {
    "id": { "$ref": "../shared/identifier.schema.json" },
    "legal_name": { "type": "string", "minLength": 1 },
    "trade_name": { "type": "string", "minLength": 1 },
    "document_number": { "$ref": "../shared/document-number.schema.json" },
    "address": { "$ref": "../shared/address.schema.json" },
    "email": { "$ref": "../shared/email.schema.json" },
    "phone": { "$ref": "../shared/phone.schema.json" },
    "logo_path": { "type": "string", "minLength": 1 },
    "consultants": {
      "type": "array",
      "items": { "$ref": "consultant.schema.json" }
    }
  },
  "required": ["id", "legal_name", "trade_name", "document_number", "address", "email", "phone", "logo_path"]
}
