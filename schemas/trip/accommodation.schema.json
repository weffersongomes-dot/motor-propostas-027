{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "accommodation.schema.json",
  "title": "Accommodation",
  "$comment": "Sprint 1B: campos obrigatórios. Corresponde a src/domain/trip/accommodation.py.",
  "type": "object",
  "properties": {
    "id": { "$ref": "../shared/identifier.schema.json" },
