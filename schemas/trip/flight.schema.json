{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flight.schema.json",
  "title": "Flight",
  "$comment": "Sprint 1B: campos obrigatórios; arrival_at >= departure_at validado em código (src/domain/trip/flight.py).",
  "type": "object",
  "properties": {
    "id": { "$ref": "../shared/identifier.schema.json" },
    "supplier_id": { "$ref": "../shared/identifier.schema.json" },
    "origin": { "$ref": "airport.schema.json" },
    "destination": { "$ref": "airport.schema.json" },
    "departure_at": { "type": "string" },
    "arrival_at": { "type": "string" }
  },
  "required": ["id", "supplier_id", "origin", "destination", "departure_at", "arrival_at"]
}
